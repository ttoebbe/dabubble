rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function joinsStartChannel(channelId) {
      return channelId == 'entwicklerteam'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds.toSet()
          == resource.data.memberIds.toSet().union([request.auth.uid].toSet());
    }

    function memberOf(collection, chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/$(collection)/$(chatId)).data.memberIds;
    }

    function changes(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validText(data) {
      return data.text is string && data.text.size() > 0 && data.text.size() <= 4000;
    }

    function validNew(data) {
      return data.authorId == request.auth.uid && validText(data) && data.createdAt is number
        && data.editedAt == null && data.reactions.size() == 0;
    }

    function canReact() {
      return changes(['reactions']) && request.resource.data.reactions.size() <= 20;
    }

    // A guest without a sign of life for a day closed the tab without logging out; any
    // signed-in person may delete that profile (ttoebbe/dabubble#6).
    function staleGuest() {
      return resource.data.isGuest == true
        && (!('lastActiveAt' in resource.data)
          || resource.data.lastActiveAt < request.time.toMillis() - 86400000);
    }

    function canEdit() {
      return resource.data.authorId == request.auth.uid
        && changes(['text', 'editedAt']) && validText(request.resource.data);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && resource.data.isGuest == true
        && (request.auth.uid == uid || staleGuest());
    }

    match /channels/{channelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if signedIn()
        && (request.auth.uid in resource.data.memberIds || joinsStartChannel(channelId));
    }

    // Reading a chat that does not exist yet is allowed (resource == null), so the app can
    // tell "no chat yet" from "no access" and creates the chat with the first message.
    match /directChats/{chatId} {
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberIds);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds[0] <= request.resource.data.memberIds[1]
        && chatId == request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1];
    }

    match /{collection}/{chatId}/messages/{messageId} {
      allow read: if collection in ['channels', 'directChats'] && memberOf(collection, chatId);
      allow create: if collection in ['channels', 'directChats'] && memberOf(collection, chatId)
        && validNew(request.resource.data)
        && request.resource.data.replyCount == 0 && request.resource.data.lastReplyAt == null;
      allow update: if collection in ['channels', 'directChats'] && memberOf(collection, chatId)
        && (canReact() || canEdit()
          || (changes(['replyCount', 'lastReplyAt'])
              && request.resource.data.replyCount == resource.data.replyCount + 1));

      match /replies/{replyId} {
        allow read: if collection in ['channels', 'directChats'] && memberOf(collection, chatId);
        allow create: if collection in ['channels', 'directChats'] && memberOf(collection, chatId)
          && validNew(request.resource.data);
        allow update: if collection in ['channels', 'directChats'] && memberOf(collection, chatId)
          && (canReact() || canEdit());
      }
    }
  }
}
