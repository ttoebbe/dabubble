# Angular routing on the DA webspace: unknown paths load index.html, so /login, /workspace
# and the other routes also work when opened directly or reloaded.
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
